{
  "manifest_version": 3,
  "name": "CoN Intel Overlay",
  "version": "1.2.6",
  "description": "Unofficial overlay to draw geo-locked intel marks on the Conflict of Nations map. Marks stay put when you pan and zoom.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.conflictnations.com/*",
    "https://*.conflictnations.com/*"
  ],
  "action": {
    "default_title": "CoN Intel Overlay",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["src/inject.js"],
      "matches": [
        "https://www.conflictnations.com/*",
        "https://*.conflictnations.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.conflictnations.com/*",
        "https://*.conflictnations.com/*"
      ],
      "js": ["src/content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
